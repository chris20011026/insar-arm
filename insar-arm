#!/bin/bash
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
export PYTHONDONTWRITEBYTECODE=1
bootstrap_python="${INSAR_BOOTSTRAP_PYTHON:-/usr/bin/python3}"
if [ ! -x "$bootstrap_python" ]; then bootstrap_python="$(command -v python3)"; fi
exec "$bootstrap_python" -I "$root/insar_arm/installer.py" "$@"
